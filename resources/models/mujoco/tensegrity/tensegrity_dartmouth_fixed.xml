        <site type="sphere" size="0.005"/>
        <tendon width="0.05" rgba="1 0 0 1" frictionloss='0' damping="10" stiffness="1000"/>
        <joint type="ball" limited="true" range="0 10" damping="100000" armature="1" />
        <position ctrllimited="true" ctrlrange="-300 100" kp="50"/>
    </default>

