<mujoco model="TT (v1.31)">
    <compiler angle="degree" coordinate="local" inertiafromgeom="true">
        <lengthrange timestep="0.001"/>
    </compiler>
    
    <option timestep="0.001"
            gravity="0 0 -9.81"
            solver="Newton"
            integrator="RK4"
            iterations="100">
        <flag sensornoise="disable"
              warmstart="disable"
              frictionloss="enable"/>
    </option>

    <visual>
        <global offwidth="1024" offheight="768"/>
    </visual>

    <default class='tensegrity'>
        <geom condim="1" material="geom" rgba="1 .84 0 1" size="0.5"
              density="100" friction="0.0001000 0.00010 0" solref="-10000 -20" solimp="0.9 0.95 0.001 0.5 2"/>
        <site type="sphere" size="0.005"/>
        <tendon width="0.05" rgba="1 0 0 1" frictionloss='0' damping="10" stiffness="1000"/>
        <joint type="ball" limited="true" range="0 10" damping="100000" armature="1" />
        <position ctrllimited="true" ctrlrange="-300 100" kp="50"/>
        <default class="cable_length">
            <general gainprm="200 0 0" biasprm="0 -1 0" gaintype="affine" biastype="affine" ctrllimited="true" ctrlrange="0 30"/>
        </default>
        <default class="rod_joint">
            <joint type="ball"  limited="true" range="0 45" pos="0 0 0"/>
        </default>
    </default>

    <asset>
        <texture name='a' builtin="gradient" height="100" rgb1="1 1 1" rgb2="0 0 0" type="skybox"
                 width="100"/>
        <texture builtin="flat" height="1278" mark="cross" markrgb="1 1 1" name="texgeom"
                 random="0.01" rgb1="0.8 0.6 0.4" rgb2="0.8 0.6 0.4" type="cube" width="127"/>
        <texture builtin="checker" height="100" name="texplane" rgb1="0 0 0" rgb2="0.8 0.8 0.8"
                 type="2d" width="100"/>
        <material name="MatPlane" reflectance="0.5" shininess="1" specular="1" texrepeat="30 30"
                  texture="texplane"/>
        <material name="geom" texture="texgeom" texuniform="true"/>
    </asset>

    <worldbody>

        <light name='mylight' cutoff="100" diffuse="1 1 1" dir="-0 0 -1.3" directional="true" exponent="1"
               pos="0 0 1.3" specular=".1 .1 .1"/>
        <geom conaffinity="1" material="MatPlane" name="floor" pos="0 0 -4.5"
              rgba="0.8 0.9 0.8 1" size="400 400 0.1" type="plane"/>

        <camera name="camera" pos="0 -80 50" axisangle="1 0 0 90"/>

        <!-- ======= RODS ======= -->
            <body name="cube0" pos="-10 0 0">
            <freejoint name="freejoint_cube_0"/>
                <geom name="cube0_geom"
                  size="3.5 3.5 3.5"
                  type="box"
                  mass="130"/>
                <site 
                    name="cube0_site" 
                    type="box"
                    pos="3.5 0 0"
                    rgba="1 0 0 1" 
                    size="1 1 1"/>
            </body>
            <body name="cube1" pos="10 0 0">
            <freejoint name="freejoint_cube_1"/>
                <geom name="cube1_geom"
                  size="3.5 3.5 3.5"
                  type="box"
                  mass="130"/>
                <site 
                    name="cube1_site" 
                    type="box"
                    pos="-3.5 0 0"
                    rgba="1 0 0 1" 
                    size="1 1 1"/>
            </body>

    </worldbody>
    <tendon>
        <!-- Tendons on XZ plane -->
        <spatial name="tendon_0_1" width="0.2" damping="5000">
            <site site="cube0_site"/>
            <site site="cube1_site"/>
        </spatial>
    </tendon>
    <actuator>
        <!-- Tendons on XZ plane -->
        <!-- <general name="u_01_02"  site="cube0_site" refsite="cube1_site" gear="1 0 0 0 0 0"  class="cable_length"/> -->
        <general name="u_01_02" tendon="tendon_0_1" gear="200 0 0 0 0 0"  class="cable_length"/>

    </actuator>
    <sensor>
        <!-- Tendons on XZ plane -->
        <tendonpos name="sensor_01_02" tendon="tendon_0_1" />


        <!-- <framepos name="end_cup_01" objtype="site" objname="cube0_site"/> -->
        <!-- <framepos name="end_cup_02" objtype="site" objname="cube1_site"/> -->

    </sensor>
</mujoco>