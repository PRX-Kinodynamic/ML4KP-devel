      markrgb="0.8 0.8 0.8" width="300" height="300" />
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5"
      reflectance="0.2" />
      
  </asset>

  


  <actuator>
    <velocity name="actuator_x" joint="joint_x" gear="1" />
    <velocity name="actuator_y" joint="joint_y" gear="1" />
    <velocity name="actuator_z" joint="joint_z" gear="1" />
    
