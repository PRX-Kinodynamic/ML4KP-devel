<mujoco>
  <option timestep="0.01" integrator="RK4" />
  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true" />
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane" friction=".5 0.005 0.001"
      priority="2" condim="4" />
  </worldbody>

  <worldbody>

    <body name="ball" pos=".0 0 .05">
      <geom name="gball_0" type="sphere" size="0.02" mass="5." material="BallMat"
        friction=".5 0.005 0.001 " condim="4" />
      <site name="sensor_ball" />
      <joint name="joint_x" type="slide" pos="0 0 0" axis="1 0 0" />
      <joint name="joint_y" type="slide" pos="0 0 0" axis="0 1 0" />
    </body>

    <body name="wall_1" pos="0.2 0.1 .05">
      <geom name="wall_1" type="box" size="0.05 0.1 0.05" mass=".1" material="static" condim="4" />
    </body>

    <body name="wall_2" pos="0.45 -0.1 .05">
      <geom name="wall_2" type="box" size="0.05 0.05 0.05" mass=".1" material="static" condim="4" />
    </body>

    <body name="movable_cube1" pos="0.3 0 .05" euler="0 0 0">
      <freejoint />
      <geom name="movable_cube1" type="box" size="0.05 0.19 0.05" mass=".1" material="movable"
        condim="4" />
    </body>

    <body name="wall_3" pos="0.7 -0.1 .05">
      <geom name="wall_3" type="box" size="0.05 0.1 0.05" mass=".1" material="static" condim="4" />
    </body>

    <body name="wall_4" pos="0.95 0.1 .05">
      <geom name="wall_4" type="box" size="0.05 0.05 0.05" mass=".1" material="static" condim="4" />
    </body>

    <body name="movable_cube2" pos="0.8 0 .05" euler="0 0 0">
      <freejoint />
      <geom name="movable_cube2" type="box" size="0.05 0.19 0.05" mass=".1" material="movable"
        condim="4" />
    </body>

    <body name="wall_5" pos="1.2 0.1 .05">
      <geom name="wall_5" type="box" size="0.05 0.1 0.05" mass=".1" material="static" condim="4" />
    </body>

    <body name="wall_6" pos="1.45 -0.1 .05">
      <geom name="wall_6" type="box" size="0.05 0.05 0.05" mass=".1" material="static" condim="4" />
    </body>

    <body name="movable_cube3" pos="1.3 0 .05" euler="0 0 0">
      <freejoint />
      <geom name="movable_cube3" type="box" size="0.05 0.19 0.05" mass=".1" material="movable"
        condim="4" />
    </body>


    <body name="case" pos="0 0 0.1">
      <geom name="gcase_a" type="box" size="0.05 0.22 0.1" pos="-.2 0 0" />
      <geom name="gcase_b" type="box" size="0.05 0.22 0.1" pos="2.1 0 0" />
      <geom name="gcase_c" type="box" size="1.2 0.04 0.1" pos="0.95 .26 0" />
      <geom name="gcase_d" type="box" size="1.2 0.04 0.1" pos="0.95 -.26 0" />
    </body>
   
    <site name="target1" pos="0.15 -0.1 0.0" size="0.12" rgba="0 1 0.6 0.2" />
    <site name="target2" pos="0.65 0.1 0.0" size="0.12" rgba="0 1 0.6 0.2" />
    <site name="target3" pos="1.15 -0.1 0.0" size="0.12" rgba="0 1 0.6 0.2" />
    <site name="target4" pos="1.65 0.1 0.0" size="0.12" rgba="0 1 0.6 0.2" />
    <site name="target5" pos="1.9 0.0 0.0" size="0.05" rgba="0 1 0.6 0.2" />

  </worldbody>

  <actuator>
    <motor name="actuator_x" joint="joint_x" gear="1" />
    <motor name="actuator_y" joint="joint_y" gear="1" />
  </actuator>

  <asset>
    <!-- Materials for visualization -->
    <material name="MatPlane" rgba="0.8 0.9 0.8 1" />
    <material name="movable" rgba="0.94 1.0 0.0 1" />
    <material name="static" rgba="0.8 0.2 0.2 1" />
    <material name="BallMat" rgba="0.2 0.2 0.8 1" />

    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512"
      height="3072" />
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4"
      rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300" />
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5"
      reflectance="0.2" />
  </asset>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0" />
    <rgba haze="0.15 0.25 0.35 1" />
    <global azimuth="60" elevation="-20" />
  </visual>


  <sensor>
    <velocimeter name="sensor_ball" site="sensor_ball" />
  </sensor>


</mujoco>