<mujoco>
    <option timestep="0.01" integrator="RK4"/>
    <worldbody>
      <light pos="0 0 1.5" dir="0 0 -1" directional="true" />
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane" friction=".5 0.005 0.001"
        priority="2" condim="4" />
    </worldbody>
  
    <worldbody>
      
      <body name="ball" pos=".0 0 .05">
        <geom name="gball_0" type="sphere" size="0.02" mass="5." material="BallMat"
          friction=".5 0.005 0.001 " condim="4" />
        <site name="sensor_ball" />
        <joint name="joint_x" type="slide" pos="0 0 0" axis="1 0 0" />
        <joint name="joint_y" type="slide" pos="0 0 0" axis="0 1 0" />
      </body>

      <body name="wall_1" pos="0.2 0.13 .05">
        <geom name="wall_1" type="box" size="0.05 0.06 0.05" mass=".1" material="static" condim="4" />
      </body>

      <body name="wall_2" pos="0.2 -0.13 .05">
        <geom name="wall_2" type="box" size="0.05 0.06 0.05" mass=".1" material="static" condim="4" />
      </body>

      <body name="movable_cube1" pos="0.2 0 .05" euler="0 0 0">
        <freejoint />
        <geom name="movable_cube1" type="box" size="0.05 0.05 0.05" mass=".1" material="movable" condim="4" />
      </body>

      <body name="wall_3" pos="0.7 0.16 .05">
        <geom name="wall_3" type="box" size="0.05 0.03 0.05" mass=".1" material="static" condim="4" />
      </body>

      <body name="wall_4" pos="0.7 -0.1 .05">
        <geom name="wall_4" type="box" size="0.05 0.08 0.05" mass=".1" material="static" condim="4" />
      </body>

      <body name="movable_cube2" pos="0.7 0.055 .05" euler="0 0 0">
        <freejoint />
        <geom name="movable_cube2" type="box" size="0.05 0.05 0.05" mass=".1" material="movable" condim="4" />
      </body>

      <body name="wall_5" pos="1.2 0.08 .05">
        <geom name="wall_5" type="box" size="0.05 0.1 0.05" mass=".1" material="static" condim="4" />
      </body>

      <body name="wall_6" pos="1.2 -0.16 .05">
        <geom name="wall_6" type="box" size="0.05 0.04 0.05" mass=".1" material="static" condim="4" />
      </body>

      <body name="movable_cube3" pos="1.2 -0.07 .05" euler="0 0 0">
        <freejoint />
        <geom name="movable_cube3" type="box" size="0.05 0.035 0.05" mass=".1" material="movable" condim="4" />
      </body>
  
      <body name="case" pos="0 0 0.1">
        <geom name="gcase_a" type="box" size="0.05 0.22 0.1" pos="-.2 0 0" />
        <geom name="gcase_b" type="box" size="0.05 0.22 0.1" pos="1.7 0 0" />       
        <geom name="gcase_c" type="box" size="1.0 0.04 0.1" pos="0.75 .26 0" />
        <geom name="gcase_d" type="box" size="1.0 0.04 0.1" pos="0.75 -.26 0" />
      </body>

