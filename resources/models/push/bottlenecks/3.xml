    <body name="case" pos="0 0 0.1">
      <geom name="gcase_a" type="box" size="0.05 0.32 0.1" pos="-.2 0 0" />
      <geom name="gcase_b" type="box" size="0.05 0.32 0.1" pos="1.7 0 0" />
      <geom name="gcase_c" type="box" size="1.0 0.04 0.1" pos="0.75 .36 0" />
      <geom name="gcase_d" type="box" size="1.0 0.04 0.1" pos="0.75 -.36 0" />
    </body>

