    </include>

    <include>
      <name> tile_8 </name>
      <uri>model://ground_friction_4</uri>
      <pose> -1 1 0 0 0 0 </pose>
    </include>

    <include>
      <uri>model://RUmnibot</uri>
      <!-- <uri>model://mecanum_simple</uri> -->
      <pose> 0 0 .04 0 0 0 </pose>
    </include>

  </world>
</sdf>