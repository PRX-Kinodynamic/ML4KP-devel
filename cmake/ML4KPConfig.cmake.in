@PACKAGE_INIT@

#include("@CMAKE_INSTALL_PREFIX@/lib/.cmake")

find_package(Boost COMPONENTS system filesystem unit_test_framework  REQUIRED)
find_package(Threads REQUIRED)

if(@BUILD_FOR_TORCH@)
	if(DEFINED ENV{Torch_DIR})
        find_package(Torch REQUIRED)
        set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} ${TORCH_CXX_FLAGS}")
    else()
		message("Please download libtorch C++, place in external folder and setup the enviornmental variable Torch_DIR accordingly.")
        add_definitions(TORCH_NOT_BUILT)
    endif()
else()
    add_definitions(-DTORCH_NOT_BUILT)
endif()



foreach(LIBRARY @ML4KP_LIBRARIES@)
	include("@PACKAGE_CMAKE_INSTALL_LIBDIR@/cmake/@CMAKE_PROJECT_NAME@/${LIBRARY}Targets.cmake")
endforeach()

include("@PACKAGE_CMAKE_INSTALL_LIBDIR@/cmake/@CMAKE_PROJECT_NAME@/ML4KPTargets.cmake")

set_and_check(@CMAKE_PROJECT_NAME@_INCLUDE_DIR "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@")
set_and_check(@CMAKE_PROJECT_NAME@_LIBRARY_DIR "@PACKAGE_CMAKE_INSTALL_LIBDIR@")

check_required_components(@CMAKE_PROJECT_NAME@)

find_package(YAMLCPP NAMES Yaml-cpp YamlCpp)