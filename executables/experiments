#!/bin/bash


if [ "$1" = "run" ]
then
    python3 run_experiments.py --run --mode indoors&
    python3 run_experiments.py --run --mode indoors_dense&
    python3 run_experiments.py --run --mode indoors_superdense
fi
if [ "$1" = "plot" ]
then
    ./plot indoors &
    ./plot indoors_dense &
    ./plot indoors_superdense
fi